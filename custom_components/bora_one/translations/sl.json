{
  "config": {
    "flow_title": "{name}",
    "step": {
      "user": {
        "title": "Dodaj BORA One",
        "description": "Povežite BORA ploščo prek Bluetootha ali dodajte simulirano ploščo za preizkus integracije.",
        "menu_options": {
          "bluetooth_pick": "BORA plošča (Bluetooth)",
          "demo": "Demo plošča (simulacija)"
        }
      },
      "bluetooth_pick": {
        "title": "Izberite ploščo",
        "data": {
          "address": "Plošča"
        }
      },
      "pair": {
        "title": "Seznanjanje z {name}",
        "description": "1. Vklopite ploščo. Tipka **Connect** na plošči mora rahlo svetiti (povezljivost vklopljena).\n2. Na telefonu izklopite Bluetooth, da aplikacija BORA One ne zaseda plošče.\n3. Kliknite **Pošlji** in glejte ploščo. Ko tipka **Connect** začne utripati, jo enkrat tapnite, da dovolite seznanjanje. Če ne utripa, Home Assistant plošče ni dosegel.\n\nHome Assistant stanje plošče samo bere, nikoli je ne upravlja."
      }
    },
    "error": {
      "pairing_failed": "Seznanjanje na plošči ni bilo potrjeno. Poskusite znova in tapnite utripajočo tipko Connect. Podrobnosti: {error}",
      "cannot_connect": "Povezava s ploščo ni uspela. Plošča mora biti vklopljena, v dosegu Bluetooth adapterja, telefon pa mora imeti Bluetooth izklopljen. Podrobnosti: {error}",
      "unknown": "Nepričakovana napaka: {error}"
    },
    "abort": {
      "already_configured": "Ta plošča je že nastavljena.",
      "no_devices_found": "BORA plošča ni najdena. Vklopite ploščo in preverite, da ima Home Assistant v bližini Bluetooth adapter ali proxy.",
      "not_supported": "Ta naprava ni podprta BORA plošča.",
      "reauth_successful": "Seznanjanje obnovljeno."
    }
  },
