{
  "config": {
    "flow_title": "{name}",
    "step": {
      "user": {
        "title": "Add BORA One",
        "description": "Connect a BORA cooktop over Bluetooth, or add a simulated cooktop to try the integration.",
        "menu_options": {
          "bluetooth_pick": "BORA cooktop (Bluetooth)",
          "demo": "Demo cooktop (simulated)"
        }
      },
      "bluetooth_pick": {
        "title": "Choose your cooktop",
        "data": {
          "address": "Cooktop"
        }
      },
      "pair": {
        "title": "Pair with {name}",
        "description": "1. Switch the cooktop on. The **Connect** button on the cooktop must be dimly lit (connectivity enabled).\n2. On your phone, switch Bluetooth off so the BORA One app does not hold the cooktop.\n3. Click **Submit** and watch the cooktop. When the **Connect** button starts to pulse, tap it once to allow pairing. If it never pulses, Home Assistant could not reach the cooktop.\n\nHome Assistant only reads the cooktop status; it never controls it."
      }
    },
    "error": {
      "pairing_failed": "Pairing was not confirmed on the cooktop. Try again and tap the pulsing Connect button. Details: {error}",
      "cannot_connect": "Could not connect to the cooktop. Make sure it is on, within range of the Bluetooth adapter and that the phone has Bluetooth off. Details: {error}",
      "unknown": "Unexpected error: {error}",
      "pairing_in_progress": "Pairing with this cooktop is already in progress. Wait for it to finish."
    },
    "abort": {
      "already_configured": "This cooktop is already configured.",
      "no_devices_found": "No BORA cooktop found. Switch the cooktop on and check that Home Assistant has a Bluetooth adapter or proxy nearby.",
      "not_supported": "This device is not a supported BORA cooktop.",
      "reauth_successful": "Pairing renewed."
    }
  },
